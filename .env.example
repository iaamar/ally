# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Supabase access
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY

# Primary assistant completion provider
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=qwen/qwen3.6-27b
LLM_REQUEST_TIMEOUT_MS=30000

# Optional assistant fallback
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Dedicated BGE embedding service
BGE_EMBEDDING_URL=http://localhost:8080
BGE_EMBEDDING_TOKEN=CHANGE_ME_TO_A_RANDOM_SECRET
BGE_REQUEST_TIMEOUT_MS=30000
BGE_MODEL_CACHE=./services/bge/.model-cache

# MCP activity cleanup and optional telemetry
CRON_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
OTEL_EXPORTER_OTLP_ENDPOINT=

# Local stdio MCP sync (optional)
ALLY_API_URL=http://localhost:3000
ALLY_API_KEY=
ALLY_PROJECT_ROOT=.
